# ==========================================================
# TechStore API - Variáveis de ambiente do backend
# Copie este arquivo para server/.env e preencha os valores.
# O frontend possui o próprio template em client/.env.example.
# ==========================================================

NODE_ENV=development
PORT=3333

# Segredo usado para assinar os JWT (mínimo de 16 caracteres).
# Gere um valor forte em produção: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-no-minimo-16-caracteres

# Conexão PostgreSQL (local, Neon, Supabase, Render...).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# Opcional. Sem este token a aplicação opera em MODO SIMULAÇÃO:
# o Pix é gerado localmente e os webhooks de teste são aceitos.
# Com o token, a API usa a integração real do Mercado Pago.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token

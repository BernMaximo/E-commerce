# ============================================
# CONFIGURAÇÕES DO BACKEND
# ============================================

# Ambiente: development, test, production
NODE_ENV=development

# Porta do servidor
PORT=3333

# Chave secreta para JWT (mínimo 16 caracteres)
JWT_SECRET=sua-chave-secreta-aqui-minimo-16-caracteres

# URL do banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ecommerce?schema=public

# Token de acesso do Mercado Pago (opcional - para testes reais)
# MERCADOPAGO_ACCESS_TOKEN=sua-chave-access-token

# ============================================
# CONFIGURAÇÕES DO FRONTEND
# ============================================

# URL da API para desenvolvimento
NEXT_PUBLIC_API_URL=http://localhost:3333